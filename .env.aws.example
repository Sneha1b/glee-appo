# Copy to .env on the EC2 host (or pass via docker run -e ...).
# These are SERVER-ONLY — do NOT prefix with VITE_.

# RDS MySQL 8 endpoint
DATABASE_URL=mysql://admin:CHANGE_ME@your-rds-endpoint.rds.amazonaws.com:3306/schedora

# AWS region (EC2 instance role provides credentials automatically)
AWS_REGION=us-east-1

# Cognito User Pool
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: derived from USER_POOL_ID if omitted
# COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxx/.well-known/jwks.json

# S3 bucket for business images (public-read)
S3_BUCKET=schedora-images-CHANGE_ME

NODE_ENV=production
PORT=3000
